# ------------------------------------------------------------------
# Nexora One — environment template
# ------------------------------------------------------------------
# Copy this file to `.env.local` and fill in your own values:
#   cp .env.example .env.local
#
# `.env*` files are git-ignored (except this template), so never commit
# a real API key.
# ------------------------------------------------------------------

# Server-side Gemini API key.
# Only needed if you enable server-side Gemini API calls
# (see `majorCapabilities` in metadata.json). The current site build is
# fully static and renders without this key.
# Get one at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Vite dev-server tuning used by AI Studio.
# Set to "true" to disable HMR + file watching (used inside AI Studio).
DISABLE_HMR=false
